  tbl_menu_item                   tbl_menu_item?                    @relation(fields: [menu_item_id], references: [id], onDelete: Restrict, map: "fk_order_item_menu_item")
  tbl_customer_orders             tbl_customer_orders               @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_order_item_order")

  @@index([order_id], map: "fk_order_item_order")
  @@index([menu_item_id], map: "idx_order_item_menu_item")
}

model tbl_customer_orders {
  id                       BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  order_token              String                         @unique(map: "order_token") @db.Char(64)
  order_number             Int?                           @db.UnsignedInt
  store_id                 Int                            @db.UnsignedInt
  daily_schedule_id        Int?
  customer_name            String?                        @db.VarChar(100)
  customer_phone           String?                        @db.VarChar(30)
  customer_email           String?                        @db.VarChar(150)
  customer_locale          String                         @default("ja") @db.VarChar(10)
  order_type               tbl_customer_orders_order_type
  scheduled_for            DateTime?                      @db.DateTime(0)
  subtotal                 Decimal?                       @default(0.00) @db.Decimal(10, 2)
  discount_amount          Decimal?                       @default(0.00) @db.Decimal(10, 2)
  tax_amount               Decimal?                       @default(0.00) @db.Decimal(10, 2)
  total_amount             Decimal                        @db.Decimal(10, 2)
  currency                 String?                        @default("JPY") @db.VarChar(10)
  status                   tbl_customer_orders_status?    @default(WAITING_PAYMENT)
  paid_at                  DateTime?                      @db.DateTime(0)
  completed_at             DateTime?                      @db.DateTime(0)
  cancel_reason            String?                        @db.MediumText
  created_at               DateTime                       @default(now()) @db.Timestamp(0)
  updated_at               DateTime                       @default(now()) @db.Timestamp(0)
  tbl_customer_order_items tbl_customer_order_items[]
  tbl_store_daily_schedule tbl_store_daily_schedule?      @relation(fields: [daily_schedule_id], references: [id], onUpdate: Restrict, map: "fk_customer_order_schedule")
  tbl_store                tbl_store                      @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_customer_order_store")
  tbl_print_jobs           tbl_print_jobs[]

  @@index([daily_schedule_id], map: "fk_customer_order_schedule")
  @@index([store_id], map: "fk_customer_order_store")
  @@index([created_at], map: "idx_created")
  @@index([order_number, created_at], map: "idx_order_number_created_at")
  @@index([order_token], map: "idx_order_token")
  @@index([store_id, status], map: "idx_store_status")
}

