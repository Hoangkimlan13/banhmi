generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model food_orders {
  id            Int                 @id @default(autoincrement())
  item_name     String              @db.VarChar(255)
  price         String              @db.VarChar(50)
  status        food_orders_status? @default(pending)
  error_message String?             @db.Text
  created_at    DateTime?           @default(now()) @db.DateTime(0)
}

model push_tokens {
  id         Int        @id @default(autoincrement())
  token      String?    @db.Text
  user_id    Int?       @db.UnsignedInt
  store_id   Int?
  created_at DateTime   @default(now()) @db.Timestamp(0)
  tbl_admin  tbl_admin? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user")

  @@index([user_id], map: "fk_user")
}

model tbl_admin {
  id                  Int                   @id @default(autoincrement()) @db.UnsignedInt
  employee_code       String?               @unique(map: "employee_code") @db.VarChar(20)
  full_name           String                @db.VarChar(100)
  full_name_display   String?               @db.VarChar(100)
  username            String                @db.VarChar(100)
  password            String                @db.VarChar(255)
  remember_token      String?               @db.VarChar(255)
  dob                 DateTime?             @db.Date
  address             String?               @db.VarChar(255)
  salary              Decimal?              @db.Decimal(10, 0)
  role                tbl_admin_role        @default(staff)
  active              Boolean               @default(true)
  sort_order          Int?                  @default(0)
  push_tokens         push_tokens[]
  tbl_shifts          tbl_shifts[]
  tbl_shifts_complete tbl_shifts_complete[]
}

model tbl_allergen {
  id                     Int                      @id @default(autoincrement())
  code                   String                   @unique(map: "code_UNIQUE") @db.VarChar(50)
  name_ja                String                   @unique(map: "name") @db.VarChar(100)
  name_vi                String?                  @db.VarChar(100)
  name_en                String?                  @db.VarChar(100)
  name_zh                String?                  @db.VarChar(100)
  description_ja         String?                  @db.Text
  description_vi         String?                  @db.Text
  description_en         String?                  @db.Text
  description_zh         String?                  @db.Text
  is_active              Boolean?                 @default(true)
  sort_order             Int?                     @default(0)
  created_at             DateTime                 @default(now()) @db.Timestamp(0)
  tbl_menu_item_allergen tbl_menu_item_allergen[]

  @@index([is_active], map: "idx_is_active")
  @@index([sort_order], map: "idx_sort_order")
}

model tbl_campaign_products {
  campaign_id   Int @db.UnsignedInt
  store_menu_id Int

  @@id([campaign_id, store_menu_id])
}

model tbl_campaigns {
  id             Int                         @id @default(autoincrement()) @db.UnsignedInt
  store_id       Int                         @db.UnsignedInt
  name           String                      @db.VarChar(150)
  discount_type  tbl_campaigns_discount_type @default(PERCENT)
  discount_value Decimal                     @db.Decimal(10, 2)
  start_at       DateTime?                   @db.DateTime(0)
  end_at         DateTime?                   @db.DateTime(0)
  is_active      Boolean?                    @default(true)
  created_at     DateTime                    @default(now()) @db.Timestamp(0)
}

model tbl_category {
  id            Int    @id @default(autoincrement()) @db.UnsignedInt
  title         String @db.VarChar(100)
  image_name    String @db.VarChar(255)
  description   String @db.Text
  description_1 String @db.Text
  featured      String @db.VarChar(20)
  active        String @db.VarChar(10)
}

model tbl_congthuc {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  title      String    @db.VarChar(100)
  content    String    @db.Text
