}

model tbl_customer_order_item_options {
  id                       Int                      @id @default(autoincrement())
  order_item_id            Int
  option_item_id           Int?                     @db.UnsignedInt
  group_name_snap          String?                  @db.VarChar(100)
  group_name_ja_snap       String?                  @db.VarChar(100)
  option_name_snap         String                   @db.VarChar(100)
  option_name_ja_snap      String?                  @db.VarChar(100)
  price_snap               Decimal                  @default(0.00) @db.Decimal(10, 2)
  tbl_customer_order_items tbl_customer_order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_customer_order_item_options_order_item")

  @@index([option_item_id], map: "fk_option_item_id")
  @@index([order_item_id], map: "fk_order_item_id")
}

model tbl_customer_order_items {
  id                              Int                               @id @default(autoincrement())
  order_id                        BigInt                            @db.UnsignedBigInt
  menu_item_id                    Int?
  food_name_snap                  String                            @db.VarChar(255)
  food_name_ja_snap               String?                           @db.VarChar(255)
  quantity                        Int
  price_at_time                   Decimal                           @db.Decimal(10, 2)
  discount_amount                 Decimal                           @default(0.00) @db.Decimal(10, 2)
  note                            String?                           @db.VarChar(255)
  image_snap                      String?                           @db.VarChar(500)
  option_total                    Decimal?                          @default(0.00) @db.Decimal(10, 2)
